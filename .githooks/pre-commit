#!/bin/sh

staged_files="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked_files_pattern='(^|/)(\.env($|\.)|customer_manager\.db$|backend/\.local/|backend/uploads/|.*\.db-shm$|.*\.db-wal$)'

if printf '%s
' "$staged_files" | grep -E "$blocked_files_pattern" >/dev/null 2>&1; then
  echo "Blocked commit: staged files contain local secrets or runtime data."
  echo "Remove them from the index before committing."
  printf '%s
' "$staged_files" | grep -E "$blocked_files_pattern"
  exit 1
fi

exit 0