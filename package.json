{
  "name": "customer-manager",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-ports.ps1 5173 8001 && python backend/generate_ssl.py",
    "dev": "concurrently -k \"python -m uvicorn backend.main:app --host 127.0.0.1 --port 8001 --reload --ssl-keyfile backend/.local/key.pem --ssl-certfile backend/.local/cert.pem\" \"vite --host 127.0.0.1 --port 5173\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preprod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/free-ports.ps1 4173 8001 && python backend/generate_ssl.py",
    "prod": "npm run build && concurrently -k \"python -m uvicorn backend.main:app --host 127.0.0.1 --port 8001 --ssl-keyfile backend/.local/key.pem --ssl-certfile backend/.local/cert.pem\" \"vite preview --host 127.0.0.1 --port 4173\"",
    "reset-password": "python -m backend.reset_password",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "animejs": "^3.2.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/animejs": "^3.1.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "concurrently": "^9.1.2",
    "jsdom": "^24.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
